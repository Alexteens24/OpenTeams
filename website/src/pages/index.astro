---
import DocsLayout from "../layouts/DocsLayout.astro";

const repository = "https://github.com/Alexteens24/OpenTeams";

const navGroups = [
  {
    label: "Bắt đầu",
    items: [
      ["#overview", "Tổng quan"],
      ["#quickstart", "Cài đặt nhanh"],
      ["#concepts", "Khái niệm cốt lõi"],
    ],
  },
  {
    label: "Sử dụng",
    items: [
      ["#player-guide", "Hướng dẫn người chơi"],
      ["#commands", "Commands"],
      ["#roles", "Roles & permissions"],
      ["#configuration", "Cấu hình"],
    ],
  },
  {
    label: "Nâng cao",
    items: [
      ["#database", "Database & runtime"],
      ["#addons", "Addon API"],
      ["#troubleshooting", "Troubleshooting"],
    ],
  },
];

const playerCommands = [
  ["/team", "Mở command center", "mọi người chơi"],
  ["/team create <name>", "Tạo team; tag được suy ra và chuẩn hóa", "chưa có team"],
  ["/team info", "Xem snapshot team hiện tại", "thành viên"],
  ["/team explore [query]", "Tìm team public theo tên hoặc tag", "mọi người chơi"],
  ["/team invitations", "Mở inbox lời mời", "mọi người chơi"],
  ["/team invite <player>", "Mời player online hoặc offline", "team.invite"],
  ["/team accept <team-id>", "Chấp nhận lời mời còn hạn", "người được mời"],
  ["/team decline <team-id>", "Từ chối lời mời", "người được mời"],
  ["/team request <team-id>", "Gửi yêu cầu vào team public", "chưa có team"],
  ["/team approve <player>", "Chấp nhận join request", "team.join-request.accept"],
  ["/team leave", "Rời team; owner phải transfer hoặc disband", "thành viên"],
  ["/team kick <player>", "Loại thành viên có role thấp hơn", "team.kick"],
  ["/team transfer <player>", "Chuyển quyền owner", "owner"],
  ["/team ban <player> [reason]", "Ban và loại player khỏi team", "team.ban"],
  ["/team unban <player>", "Gỡ ban", "team.ban"],
  ["/team role <player> <role>", "Đổi role của thành viên", "team.role.change"],
  ["/team rename <name>", "Đổi tên team", "team.rename"],
  ["/team tag <tag>", "Đổi tag hiển thị", "team.settings.manage"],
  ["/team visibility <public|private>", "Đổi khả năng xuất hiện trong Explore", "team.settings.manage"],
  ["/team setting <key> <value>", "Ghi setting typed của Core/addon", "permission của setting"],
  ["/team chat", "Bật hoặc tắt chế độ team chat", "thành viên"],
  ["/team chat <message>", "Gửi một tin vào team chat", "thành viên"],
  ["/team disband confirm", "Giải tán team sau xác nhận", "owner"],
];

const adminCommands = [
  ["/teamadmin", "Xem database mode, UI adapter và số addon command", "openteams.admin"],
  ["/teamadmin doctor", "Kiểm tra lease, orphan rows và domain invariants", "openteams.admin"],
  ["/teamadmin cleanup confirm", "Dọn audit/invitation/request hết hạn", "openteams.admin"],
  ["/teamadmin spy", "Bật/tắt staff team-chat spy", "openteams.admin.spy"],
];

const roles = [
  ["Owner", "1000", "*", "Toàn quyền; role được bảo vệ và chỉ có một người."],
  ["Co-owner", "750", "invite, kick, ban, approve, role, rename, settings", "Quản trị team gần như đầy đủ, không thể thao tác lên owner."],
  ["Moderator", "500", "invite, kick, ban, approve", "Quản lý thành viên có priority thấp hơn."],
  ["Member", "100", "—", "Chat, xem team và tự rời team."],
];

const configRows = [
  ["database.type", "sqlite", "sqlite, mysql, mariadb", "Engine lưu trữ."],
  ["database.namespace", "default", "chuỗi riêng", "Cô lập dữ liệu và lease trong cùng database."],
  ["database.pool-size", "8", ">= 1", "Số connection tối đa; SQLite vẫn tuần tự hóa JDBC."],
  ["database.connection-timeout-ms", "3000", ">= 250", "Thời gian chờ connection trước khi degrade."],
  ["team.default-member-limit", "20", "số nguyên", "Giới hạn thành viên cho team mới."],
  ["team.invitation-expiry-seconds", "604800", "giây", "Tuổi thọ invitation và join request."],
  ["ui.mode", "auto", "auto, dialog, chat", "Chọn Paper Dialog hoặc clickable chat fallback."],
  ["ui.default-locale", "vi_VN", "locale Java", "Locale fallback cho UI."],
  ["ui.follow-player-locale", "false", "boolean", "Theo locale từ Minecraft client nếu có translation."],
  ["friendly-fire.mode", "deny", "allow, deny", "Quy tắc damage giữa đồng đội."],
  ["audit.retention-days", "90", "số ngày", "Thời gian giữ mutation audit."],
  ["addons.policy-global-timeout-ms", "500", "milliseconds", "Deadline chung cho policy chain."],
];

const sqliteConfig = `database:
  type: sqlite
  namespace: default
  sqlite-file: openteams.db
  pool-size: 8
  connection-timeout-ms: 3000`;

const mysqlConfig = `database:
  type: mysql              # hoặc mariadb
  namespace: survival-01
  host: db.internal
  port: 3306
  database: openteams
  username: openteams
  password: change-me
  pool-size: 8
  connection-timeout-ms: 3000`;

const serviceCode = `OpenTeams api = Bukkit.getServicesManager()
    .load(OpenTeams.class);

if (api == null) {
    throw new IllegalStateException("OpenTeams API unavailable");
}

// Hot path: cache-only, không JDBC.
MembershipLookup membership = api.teams()
    .membershipCached(player.getUniqueId());

// Authoritative: async, có thể chạm database.
api.teams().findByPlayer(player.getUniqueId())
    .thenAccept(team -> team.ifPresent(this::consumeSnapshot));`;

const uiCode = `Registration action = api.userInterface().register(plugin,
    new TeamUiRegistry.UiAction(
        "dashboard",
        TeamUiRegistry.Area.DASHBOARD,
        100, // priority
        "example.ui.label",
        "example.ui.description",
        "example.use",
        context -> true,
        context -> CompletableFuture.completedFuture(
            TeamUiRegistry.ActionOutcome.REFRESH)
    ));`;

const mutationCode = `api.teams().invite(new TeamRequests.TargetAction(
    actorId, teamId, targetId
)).thenAccept(result -> {
    if (result instanceof OperationResult.Success<TeamSnapshot> success) {
        TeamSnapshot committed = success.value();
        return;
    }

    var failure = (OperationResult.Failure<TeamSnapshot>) result;
    getLogger().warning(failure.code() + " / " + failure.correlationId());
});`;
---

<DocsLayout
  title="OpenTeams Docs — Paper & Folia Team Platform"
  description="Tài liệu chuyên sâu về cài đặt, commands, roles, database runtime và addon API của OpenTeams."
>
  <div class="noise" aria-hidden="true"></div>

  <header class="topbar">
    <button class="mobile-menu icon-button" data-menu-toggle aria-label="Mở menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="#overview" aria-label="OpenTeams Docs">
      <span class="brand-mark"><i></i><b>OT</b></span>
      <span class="brand-copy"><strong>OpenTeams</strong><small>Documentation</small></span>
      <span class="version">indev</span>
    </a>
    <div class="top-actions">
      <button class="search-trigger" data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        <span>Tìm trong tài liệu</span><kbd>⌘ K</kbd>
      </button>
      <button class="icon-button theme-toggle" data-theme-toggle aria-label="Đổi giao diện">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"/></svg>
      </button>
      <a class="icon-button" href={repository} target="_blank" rel="noreferrer" aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M12 .8A11.4 11.4 0 0 0 8.4 23c.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.3-3.9-1.3-.5-1.4-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.7 2.7 1.2 3.3.9.1-.7.4-1.2.8-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8-.8c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3c0 .3.2.6.8.5A11.4 11.4 0 0 0 12 .8Z"/></svg>
      </a>
    </div>
  </header>

  <div class="app-shell">
    <aside class="sidebar" data-sidebar>
      <div class="sidebar-scroll">
        {navGroups.map((group) => (
          <div class="nav-group">
            <p>{group.label}</p>
            <nav>
              {group.items.map(([href, label]) => (
                <a href={href} class={href === "#overview" ? "active" : ""}><span></span>{label}</a>
              ))}
            </nav>
          </div>
        ))}
      </div>
      <div class="sidebar-card">
        <span class="status-pulse"></span>
        <div><strong>1.0.0-SNAPSHOT</strong><small>Java 21 · Paper/Folia</small></div>
      </div>
    </aside>

    <main>
      <section id="overview" class="hero anchor-section" data-title="Tổng quan" data-description="OpenTeams là gì và phù hợp với server nào">
        <div class="hero-grid"></div>
        <div class="hero-content">
          <div class="eyebrow"><span>●</span> Correctness-first team platform</div>
          <h1>Team system không chỉ chạy.<br/><em>Nó phải chạy đúng.</em></h1>
          <p>OpenTeams là nền tảng quản lý team cho Paper và Folia, kết hợp giao diện Dialog-first cho người chơi với database transaction, immutable cache và extension API dành cho addon.</p>
          <div class="hero-actions">
            <a class="button primary" href="#quickstart">Bắt đầu cài đặt <span>→</span></a>
            <a class="button ghost" href="#addons">Tích hợp addon</a>
          </div>
          <div class="hero-meta">
            <span><b>01</b> Paper 1.21.11+</span>
            <span><b>02</b> SQLite · MySQL · MariaDB</span>
            <span><b>03</b> Apache-2.0</span>
          </div>
        </div>
        <div class="hero-visual" aria-label="OpenTeams runtime status">
          <div class="visual-toolbar"><span></span><span></span><span></span><small>openteams / runtime</small></div>
          <div class="runtime-panel">
            <div class="runtime-head"><span class="live-dot"></span><b>Runtime healthy</b><small>WRITABLE</small></div>
            <div class="runtime-metric"><span>Database lease</span><strong>acquired</strong></div>
            <div class="runtime-metric"><span>Cache mode</span><strong>immutable</strong></div>
            <div class="runtime-metric"><span>UI adapter</span><strong>dialog</strong></div>
            <div class="runtime-log"><i>13:52:03</i><span>✓ Schema baseline validated</span><i>13:52:04</i><span>✓ Recovery cache published</span></div>
          </div>
        </div>
      </section>

      <section class="principles" aria-label="Nguyên tắc thiết kế">
        <article><div class="card-icon">⌁</div><h2>Giao diện thích ứng</h2><p>Paper Dialog khi khả dụng, clickable chat khi không. Lỗi đóng Dialog trước để người chơi luôn đọc được phản hồi.</p></article>
        <article><div class="card-icon">◇</div><h2>Database là nguồn sự thật</h2><p>Mỗi mutation ghi domain rows và audit trong cùng transaction; cache chỉ publish sau commit.</p></article>
        <article><div class="card-icon">↗</div><h2>API có ownership</h2><p>Extension gắn với Bukkit Plugin thực, có timeout contract và được dọn tự động khi addon disable.</p></article>
      </section>

      <section id="quickstart" class="doc-section anchor-section" data-title="Cài đặt nhanh" data-description="Build JAR, cấu hình server và xác minh lần khởi động đầu">
        <header class="section-head"><span>01</span><div><p>GETTING STARTED</p><h2>Cài đặt nhanh</h2><em>Khoảng 3 phút</em></div></header>
        <p class="lead">OpenTeams hiện là bản indev: build bytecode Java 21, target Paper/Folia 1.21.11+ và chưa đóng băng schema phát hành.</p>
        <div class="requirements">
          <div><span>Java</span><b>21+</b><small>Runtime mới hơn vẫn có thể chạy bytecode 21.</small></div>
          <div><span>Server</span><b>Paper / Folia</b><small>API version 1.21.11 trở lên.</small></div>
          <div><span>Storage</span><b>SQLite mặc định</b><small>Không cần cài database riêng để thử.</small></div>
        </div>
        <ol class="steps">
          <li><span>1</span><div><h3>Build artifact</h3><p>Clone repository và chạy Gradle wrapper. Deployable JAR nằm trong module Core.</p><pre><code>./gradlew clean build
# → openteams-core/build/libs/openteams-core-1.0.0-SNAPSHOT.jar</code></pre></div></li>
          <li><span>2</span><div><h3>Cài vào server</h3><p>Stop server, đưa JAR vào <code>plugins/</code>, sau đó start lại. Không dùng PlugMan cho plugin giữ connection pool và lease.</p><pre><code>cp openteams-core/build/libs/openteams-core-*.jar server/plugins/
cd server && java -jar paper.jar --nogui</code></pre></div></li>
          <li><span>3</span><div><h3>Xác minh runtime</h3><p>Log phải đi tới <code>WRITABLE</code>. Trong console hoặc game với quyền admin, chạy doctor.</p><pre><code>teamadmin doctor
# Expect: lease valid · invariants 0 · runtime WRITABLE</code></pre></div></li>
        </ol>
        <aside class="callout warning"><span>!</span><div><b>Schema development baseline</b><p>Không có upgrade migration trong giai đoạn indev. Nếu database được tạo bởi alpha schema cũ, hãy backup rồi xóa database thử nghiệm để Core tạo lại <code>V1__core_schema.sql</code>.</p></div></aside>
      </section>

      <section id="concepts" class="doc-section anchor-section" data-title="Khái niệm cốt lõi" data-description="Snapshot, mutation, cache, correlation ID và consistency model">
        <header class="section-head"><span>02</span><div><p>MENTAL MODEL</p><h2>Khái niệm cốt lõi</h2></div></header>
        <p class="lead">Hiểu năm khái niệm này sẽ giúp bạn vận hành server và viết addon đúng với consistency model của OpenTeams.</p>
        <div class="concept-list">
          <article><span>Snapshot</span><div><h3>Dữ liệu public là bất biến</h3><p><code>TeamSnapshot</code> chứa version, settings và member list đã copy. Snapshot không tự cập nhật; query lại khi cần dữ liệu mới.</p></div></article>
          <article><span>Cache</span><div><h3>Hot path không chạm JDBC</h3><p>Team chat, friendly fire và các method có hậu tố <code>Cached</code> chỉ đọc immutable cache. <code>MembershipLookup</code> phân biệt loaded, absent, loading và failed.</p></div></article>
          <article><span>Mutation</span><div><h3>Một transaction, một kết quả</h3><p>Validation, domain write, version increment và audit record cùng commit. Optimistic conflict được retry có giới hạn, không ghi đè mù.</p></div></article>
          <article><span>Correlation</span><div><h3>Theo dấu xuyên suốt pipeline</h3><p>Mỗi write có một UUID xuất hiện trong <code>OperationResult</code>, audit row và <code>TeamMutationCommittedEvent</code>.</p></div></article>
          <article><span>Lease</span><div><h3>Chỉ một writer cho mỗi namespace</h3><p>Lease kèm fencing token ngăn instance cũ commit sau takeover. Khi mất lease, runtime hạ read-only thay vì ghi không an toàn.</p></div></article>
        </div>
      </section>

      <section id="player-guide" class="doc-section anchor-section" data-title="Hướng dẫn người chơi" data-description="Tạo team, mời offline, join request, team chat và giải tán">
        <header class="section-head"><span>03</span><div><p>PLAYER FLOWS</p><h2>Hướng dẫn người chơi</h2></div></header>
        <div class="flow-grid">
          <article><span>01</span><h3>Tạo và nhận diện team</h3><p>Dùng <code>/team create &lt;name&gt;</code>. Tên được normalize để chống trùng khác hoa/thường; tag ngắn dùng trong team chat.</p></article>
          <article><span>02</span><h3>Mời cả player offline</h3><p><code>/team invite &lt;player&gt;</code> tra last-known player directory. Lời mời vẫn tồn tại khi target offline và xuất hiện trong inbox lần sau.</p></article>
          <article><span>03</span><h3>Public discovery</h3><p>Team public xuất hiện trong Explore. Player có thể gửi join request; moderator trở lên approve từ dashboard hoặc command.</p></article>
          <article><span>04</span><h3>Team chat riêng tư</h3><p><code>/team chat</code> lưu preference qua lần đăng nhập. Trong lúc preference đang load, Core không phát nhầm tin team ra global chat.</p></article>
          <article><span>05</span><h3>Rời team đúng vai trò</h3><p>Member có thể leave trực tiếp. Owner phải transfer ownership hoặc disband; điều này tránh team active không còn chủ sở hữu.</p></article>
          <article><span>06</span><h3>Thao tác rủi ro có xác nhận</h3><p>Transfer, leave và disband dùng confirmation UI. Nếu operation lỗi, Dialog đóng để phản hồi chat không bị che.</p></article>
        </div>
      </section>

      <section id="commands" class="doc-section anchor-section" data-title="Commands" data-description="Danh sách đầy đủ player và admin commands cùng permission">
        <header class="section-head"><span>04</span><div><p>REFERENCE</p><h2>Commands</h2></div></header>
        <p class="lead">Lệnh gốc <code>/team</code> yêu cầu Bukkit permission <code>openteams.command.team</code> (mặc định: true). Permission trong cột cuối là team permission nội bộ.</p>
        <div class="tabs" data-tabs>
          <div role="tablist"><button class="active" data-tab="player">Player commands <b>{playerCommands.length}</b></button><button data-tab="admin">Admin commands <b>{adminCommands.length}</b></button></div>
          <div class="table-wrap active" data-panel="player"><table><thead><tr><th>Command</th><th>Chức năng</th><th>Yêu cầu</th></tr></thead><tbody>{playerCommands.map((row) => <tr>{row.map((cell, i) => <td>{i === 0 || i === 2 ? <code>{cell}</code> : cell}</td>)}</tr>)}</tbody></table></div>
          <div class="table-wrap" data-panel="admin"><table><thead><tr><th>Command</th><th>Chức năng</th><th>Bukkit permission</th></tr></thead><tbody>{adminCommands.map((row) => <tr>{row.map((cell, i) => <td>{i !== 1 ? <code>{cell}</code> : cell}</td>)}</tr>)}</tbody></table></div>
        </div>
      </section>

      <section id="roles" class="doc-section anchor-section" data-title="Roles và permissions" data-description="Priority, permission mặc định và quy tắc quản lý role">
        <header class="section-head"><span>05</span><div><p>AUTHORIZATION</p><h2>Roles & permissions</h2></div></header>
        <p class="lead">Authorization dựa trên permission key; các thao tác lên người khác còn yêu cầu role priority của actor lớn hơn target.</p>
        <div class="role-stack">{roles.map(([name, priority, permissions, description], i) => <article><span class={`role-badge role-${i}`}>{name.slice(0, 1)}</span><div><h3>{name}<small>priority {priority}</small></h3><p>{description}</p><code>{permissions}</code></div></article>)}</div>
        <aside class="callout"><span>i</span><div><b>Owner wildcard</b><p>Owner nhận <code>*</code>. Addon permissions đăng ký với <code>defaultRoles</code> được merge vào snapshot và được authorization layer xét nhất quán cho typed settings.</p></div></aside>
      </section>

      <section id="configuration" class="doc-section anchor-section" data-title="Cấu hình" data-description="Toàn bộ config keys, database examples, UI locale và policy timeout">
        <header class="section-head"><span>06</span><div><p>CONFIG.YML</p><h2>Cấu hình</h2></div></header>
        <div class="config-switcher">
          <div class="code-card"><header><span>SQLite · local</span><button data-copy="sqlite-code">Copy</button></header><pre id="sqlite-code"><code>{sqliteConfig}</code></pre></div>
          <div class="code-card"><header><span>MySQL / MariaDB · network</span><button data-copy="mysql-code">Copy</button></header><pre id="mysql-code"><code>{mysqlConfig}</code></pre></div>
        </div>
        <h3 class="subheading">Config reference</h3>
        <div class="table-wrap config-table"><table><thead><tr><th>Key</th><th>Mặc định</th><th>Giá trị</th><th>Ý nghĩa</th></tr></thead><tbody>{configRows.map((row) => <tr>{row.map((cell, i) => <td>{i < 3 ? <code>{cell}</code> : cell}</td>)}</tr>)}</tbody></table></div>
        <aside class="callout warning"><span>!</span><div><b>Không chia sẻ một namespace cho hai server active</b><p>Lease sẽ chỉ cho một instance giữ quyền ghi. Dùng namespace khác nhau nếu hai server cần tập dữ liệu độc lập.</p></div></aside>
      </section>

      <section id="database" class="doc-section anchor-section" data-title="Database và runtime" data-description="Runtime state machine, lease fencing, recovery và operational runbook">
        <header class="section-head"><span>07</span><div><p>OPERATIONS</p><h2>Database & runtime</h2></div></header>
        <p class="lead">OpenTeams ưu tiên ngừng ghi an toàn thay vì duy trì availability bằng dữ liệu không nhất quán.</p>
        <div class="state-machine">
          <div><span>01</span><b>STARTING</b><small>config → schema → roles → lease</small></div><i>→</i>
          <div class="healthy"><span>02</span><b>WRITABLE</b><small>reads + mutations</small></div><i>⇄</i>
          <div class="danger"><span>03</span><b>DEGRADED</b><small>cached reads only</small></div><i>→</i>
          <div><span>04</span><b>RECOVERING</b><small>rebuild online cache</small></div>
        </div>
        <div class="deep-grid">
          <article><h3>Write fencing</h3><p>Mỗi takeover tăng fence token. Mọi mutation lock và kiểm tra <code>instance_id + fence_token</code> trong chính transaction domain.</p></article>
          <article><h3>Consistent aggregate reads</h3><p>Team row, members, role permissions và settings được load trong explicit read transaction để snapshot không bị xé giữa nhiều SELECT.</p></article>
          <article><h3>Recovery publication</h3><p>Online memberships được resolve theo batch, team được deduplicate, sau đó toàn bộ cache state mới được publish atomically.</p></article>
          <article><h3>Audit retention</h3><p>Mutation audit giữ correlation ID và được dọn bằng <code>/teamadmin cleanup confirm</code> theo retention config.</p></article>
        </div>
        <h3 class="subheading">Runbook deploy an toàn</h3>
        <div class="runbook"><div><b>1</b><p><strong>Backup</strong><span>Copy SQLite file khi server đã stop, hoặc snapshot MySQL/MariaDB.</span></p></div><div><b>2</b><p><strong>Stop server</strong><span>Để plugin release lease và đóng Hikari pool sạch.</span></p></div><div><b>3</b><p><strong>Replace JAR</strong><span>Không hot reload; giữ nguyên config nếu schema tương thích.</span></p></div><div><b>4</b><p><strong>Start & doctor</strong><span>Xác nhận WRITABLE, lease hợp lệ và invariant count bằng 0.</span></p></div></div>
      </section>

      <section id="addons" class="doc-section anchor-section" data-title="Addon API" data-description="Service discovery, cache contract, UI actions, mutations và lifecycle ownership">
        <header class="section-head"><span>08</span><div><p>DEVELOPER API</p><h2>Phát triển addon</h2></div></header>
        <p class="lead">Khai báo <code>depend: [OpenTeams]</code>, compile against module <code>openteams-api</code> và lấy service từ Bukkit. Không compile trực tiếp vào Core implementation.</p>
        <div class="code-card wide"><header><span>Service discovery & queries</span><button data-copy="service-code">Copy</button></header><pre id="service-code"><code>{serviceCode}</code></pre></div>
        <h3 class="subheading">Extension registries</h3>
        <div class="registry-grid">
          <article><code>commands()</code><p>Async <code>/team</code> subcommands, aliases và Bukkit permission.</p></article>
          <article><code>placeholders()</code><p>Cache-only Adventure Component resolver với fallback.</p></article>
          <article><code>settings()</code><p>Typed value, codec, validator và permission cho mỗi setting.</p></article>
          <article><code>permissions()</code><p>Permission key, translation và default team roles.</p></article>
          <article><code>userInterface()</code><p>Action ở dashboard, members hoặc settings với priority.</p></article>
          <article><code>translations()</code><p>Translation map theo Java Locale; fallback qua Core locale.</p></article>
          <article><code>policies()</code><p>Pre-commit policy có priority và timeout tối đa 2 giây.</p></article>
        </div>
        <div class="two-code">
          <div class="code-card"><header><span>UI contribution</span><button data-copy="ui-code">Copy</button></header><pre id="ui-code"><code>{uiCode}</code></pre></div>
          <div class="code-card"><header><span>Mutation result</span><button data-copy="mutation-code">Copy</button></header><pre id="mutation-code"><code>{mutationCode}</code></pre></div>
        </div>
        <div class="contract-grid"><article><span>SYNC</span><h3>Cache resolver</h3><p>Placeholder và visibility callback phải non-blocking, không database, HTTP hoặc Bukkit entity mutation.</p></article><article><span>ASYNC</span><h3>Queries & mutations</h3><p>Completion callback chạy trên OpenTeams worker. Schedule về Paper/Folia trước khi sửa player, entity, inventory.</p></article><article><span>LIFECYCLE</span><h3>Registration ownership</h3><p>Giữ và close <code>Registration</code> trong <code>onDisable</code>. Core vẫn tự remove contribution khi plugin disable.</p></article></div>
      </section>

      <section id="troubleshooting" class="doc-section anchor-section" data-title="Troubleshooting" data-description="Xử lý lỗi schema, read-only, Dialog, offline player và hot reload">
        <header class="section-head"><span>09</span><div><p>RUNBOOK</p><h2>Troubleshooting</h2></div></header>
        <div class="faq-list">
          <details open><summary><span>Database báo “no such table” khi khởi động</span><b>+</b></summary><div><p>Trong indev, database alpha cũ không được migrate. Stop server, backup và xóa database thử nghiệm cũ cùng file <code>-shm</code>/<code>-wal</code>, rồi start để Flyway tạo schema baseline. Nếu database mới vẫn không có bảng, kiểm tra migration resource có nằm trong JAR.</p></div></details>
          <details><summary><span>Runtime chuyển sang READ_ONLY</span><b>+</b></summary><div><p>Chạy <code>/teamadmin doctor</code>, kiểm tra database connectivity và xem có instance khác đang giữ cùng namespace không. Không ép ghi. Core sẽ tự đi qua RECOVERING và chỉ trở lại WRITABLE sau khi cache online-player được rebuild.</p></div></details>
          <details><summary><span>Không thấy Paper Dialog</span><b>+</b></summary><div><p>Để <code>ui.mode: auto</code>. Core tự fallback về clickable chat nếu API Dialog không khả dụng. <code>dialog</code> chỉ nên dùng khi server build hỗ trợ chắc chắn; <code>chat</code> dùng để ép UI tương thích.</p></div></details>
          <details><summary><span>Invite player offline không tìm thấy</span><b>+</b></summary><div><p>OpenTeams dùng last-known player directory. Player phải từng được server ghi nhận tên, hoặc server phải có offline profile hợp lệ. Kiểm tra chính tả và thử lại sau khi player đã join ít nhất một lần.</p></div></details>
          <details><summary><span>Có thể reload bằng PlugMan không?</span><b>+</b></summary><div><p>Không được hỗ trợ. OpenTeams sở hữu database pool, lease heartbeat, async workers, cache và addon registrations. Stop/start server đầy đủ giúp lifecycle đóng và mở lại theo đúng thứ tự.</p></div></details>
        </div>
        <aside class="callout"><span>?</span><div><b>Khi cần debug sâu</b><p>Giữ log từ lúc <code>Enabling OpenTeams</code>, output của <code>/teamadmin doctor</code>, database engine/version và Paper build. Correlation ID trong lỗi mutation nối trực tiếp với audit record.</p></div></aside>
      </section>

